map "$request_method:$uri" $registration_client_key {
    default "";
    "POST:/api/v1/auth/register" $binary_remote_addr;
}

map "$request_method:$uri" $registration_global_key {
    default "";
    "POST:/api/v1/auth/register" registration;
}

map "$request_method:$uri" $login_client_key {
    default "";
    "POST:/api/v1/auth/login" $binary_remote_addr;
}

map "$request_method:$uri" $login_global_key {
    default "";
    "POST:/api/v1/auth/login" login;
}

map "$request_method:$uri" $refresh_client_key {
    default "";
    "POST:/api/v1/auth/refresh" $binary_remote_addr;
}

map "$request_method:$uri" $refresh_global_key {
    default "";
    "POST:/api/v1/auth/refresh" refresh;
}

map "$request_method:$uri" $logout_client_key {
    default "";
    "POST:/api/v1/auth/logout" $binary_remote_addr;
}

map "$request_method:$uri" $logout_global_key {
    default "";
    "POST:/api/v1/auth/logout" logout;
}

map $http_origin $cors_allow_origin {
    default "";
    "${REGISTRATION_CORS_ALLOWED_ORIGIN}" $http_origin;
}

map $uri $reject_ambiguous_auth_path {
    default 0;
    ~^/api/v1/auth/register/ 1;
    ~^/api/v1/auth/register\; 1;
    ~^/api/v1/auth/login/ 1;
    ~^/api/v1/auth/login\; 1;
    ~^/api/v1/auth/refresh/ 1;
    ~^/api/v1/auth/refresh\; 1;
    ~^/api/v1/auth/logout/ 1;
    ~^/api/v1/auth/logout\; 1;
    ~^/api/v1/admin/categories/ 1;
    ~^/api/v1/admin/categories\; 1;
    ~^/api/v1/admin/products/ 1;
    ~^/api/v1/admin/products\; 1;
}

limit_req_zone $registration_client_key zone=registration_per_ip:1m rate=${REGISTRATION_PER_IP_RATE};
limit_req_zone $registration_global_key zone=registration_global:1m rate=${REGISTRATION_GLOBAL_RATE};
limit_req_zone $login_client_key zone=login_per_ip:1m rate=${LOGIN_PER_IP_RATE};
limit_req_zone $login_global_key zone=login_global:1m rate=${LOGIN_GLOBAL_RATE};
limit_req_zone $refresh_client_key zone=refresh_per_ip:1m rate=${REFRESH_PER_IP_RATE};
limit_req_zone $refresh_global_key zone=refresh_global:1m rate=${REFRESH_GLOBAL_RATE};
limit_req_zone $logout_client_key zone=logout_per_ip:1m rate=${LOGOUT_PER_IP_RATE};
limit_req_zone $logout_global_key zone=logout_global:1m rate=${LOGOUT_GLOBAL_RATE};

log_format lyrashop_api
    '$remote_addr "$request" status=$status upstream=$upstream_addr '
    'request_time=$request_time upstream_time=$upstream_response_time '
    'limit_req=$limit_req_status';

resolver ${BACKEND_DNS_RESOLVER} valid=10s ipv6=off;

upstream lyrashop_backend {
    zone lyrashop_backend 64k;
    server ${BACKEND_HOST}:${BACKEND_PORT} resolve;
    keepalive 32;
}

server {
    listen 8080 default_server;
    server_name _;
    return 444;
}

server {
    listen 8080;
    server_name ${API_SERVER_NAME};
    server_tokens off;
    merge_slashes on;

    access_log /var/log/nginx/access.log lyrashop_api;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Forwarded "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_intercept_errors off;

    limit_req_status 429;
    limit_req_log_level notice;

    if ($reject_ambiguous_auth_path) {
        return 404;
    }

    location = /nginx-health {
        access_log off;
        return 204;
    }

    location = /actuator {
        return 404;
    }

    location ^~ /actuator/ {
        return 404;
    }

    location = /api/v1/auth/register {
        client_max_body_size ${AUTH_MAX_REQUEST_BODY_BYTES};
        proxy_request_buffering on;
        add_header Access-Control-Expose-Headers "Retry-After, X-XSRF-TOKEN" always;

        limit_req zone=registration_per_ip burst=${REGISTRATION_PER_IP_BURST} nodelay;
        limit_req zone=registration_global burst=${REGISTRATION_GLOBAL_BURST} nodelay;

        error_page 413 = @registration_payload_too_large;
        error_page 429 = @registration_rate_limited;

        proxy_pass http://lyrashop_backend;
    }

    location @registration_rate_limited {
        internal;
        default_type application/problem+json;
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Expose-Headers "Retry-After, X-XSRF-TOKEN" always;
        add_header Vary "Origin" always;
        add_header Retry-After "${REGISTRATION_RETRY_AFTER_SECONDS}" always;
        add_header Cache-Control "no-store" always;
        return 429 '{"timestamp":"$time_iso8601","status":429,"code":"REGISTRATION_RATE_LIMITED","message":"Too many registration attempts","path":"/api/v1/auth/register","fieldErrors":{}}';
    }

    location @registration_payload_too_large {
        internal;
        default_type application/problem+json;
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Vary "Origin" always;
        add_header Cache-Control "no-store" always;
        return 413 '{"timestamp":"$time_iso8601","status":413,"code":"PAYLOAD_TOO_LARGE","message":"Request body exceeds the allowed size","path":"/api/v1/auth/register","fieldErrors":{}}';
    }

    location = /api/v1/auth/login {
        client_max_body_size ${LOGIN_MAX_REQUEST_BODY_BYTES};
        proxy_request_buffering on;
        add_header Access-Control-Expose-Headers "Retry-After, X-XSRF-TOKEN" always;

        limit_req zone=login_per_ip burst=${LOGIN_PER_IP_BURST} nodelay;
        limit_req zone=login_global burst=${LOGIN_GLOBAL_BURST} nodelay;

        error_page 413 = @login_payload_too_large;
        error_page 429 = @login_rate_limited;

        proxy_pass http://lyrashop_backend;
    }

    location @login_rate_limited {
        internal;
        default_type application/problem+json;
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Expose-Headers "Retry-After, X-XSRF-TOKEN" always;
        add_header Vary "Origin" always;
        add_header Retry-After "${LOGIN_RETRY_AFTER_SECONDS}" always;
        add_header Cache-Control "no-store" always;
        return 429 '{"timestamp":"$time_iso8601","status":429,"code":"LOGIN_RATE_LIMITED","message":"Too many login attempts","path":"/api/v1/auth/login","fieldErrors":{}}';
    }

    location @login_payload_too_large {
        internal;
        default_type application/problem+json;
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Vary "Origin" always;
        add_header Cache-Control "no-store" always;
        return 413 '{"timestamp":"$time_iso8601","status":413,"code":"PAYLOAD_TOO_LARGE","message":"Request body exceeds the allowed size","path":"/api/v1/auth/login","fieldErrors":{}}';
    }

    location = /api/v1/auth/refresh {
        client_max_body_size ${REFRESH_MAX_REQUEST_BODY_BYTES};
        proxy_request_buffering on;
        add_header Access-Control-Expose-Headers "Retry-After, X-XSRF-TOKEN" always;

        limit_req zone=refresh_per_ip burst=${REFRESH_PER_IP_BURST} nodelay;
        limit_req zone=refresh_global burst=${REFRESH_GLOBAL_BURST} nodelay;

        error_page 413 = @refresh_payload_too_large;
        error_page 429 = @refresh_rate_limited;

        proxy_pass http://lyrashop_backend;
    }

    location @refresh_rate_limited {
        internal;
        default_type application/problem+json;
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Expose-Headers "Retry-After, X-XSRF-TOKEN" always;
        add_header Vary "Origin" always;
        add_header Retry-After "${REFRESH_RETRY_AFTER_SECONDS}" always;
        add_header Cache-Control "no-store" always;
        return 429 '{"timestamp":"$time_iso8601","status":429,"code":"REFRESH_RATE_LIMITED","message":"Too many refresh attempts","path":"/api/v1/auth/refresh","fieldErrors":{}}';
    }

    location @refresh_payload_too_large {
        internal;
        default_type application/problem+json;
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Vary "Origin" always;
        add_header Cache-Control "no-store" always;
        return 413 '{"timestamp":"$time_iso8601","status":413,"code":"PAYLOAD_TOO_LARGE","message":"Request body exceeds the allowed size","path":"/api/v1/auth/refresh","fieldErrors":{}}';
    }

    location = /api/v1/auth/logout {
        client_max_body_size ${LOGOUT_MAX_REQUEST_BODY_BYTES};
        proxy_request_buffering on;
        add_header Access-Control-Expose-Headers "Retry-After, X-XSRF-TOKEN" always;

        limit_req zone=logout_per_ip burst=${LOGOUT_PER_IP_BURST} nodelay;
        limit_req zone=logout_global burst=${LOGOUT_GLOBAL_BURST} nodelay;

        error_page 413 = @logout_payload_too_large;
        error_page 429 = @logout_rate_limited;

        proxy_pass http://lyrashop_backend;
    }

    location = /api/v1/admin/categories {
        client_max_body_size ${BUSINESS_MAX_REQUEST_BODY_BYTES};
        proxy_request_buffering on;
        proxy_pass http://lyrashop_backend;
    }

    location = /api/v1/admin/products {
        client_max_body_size ${BUSINESS_MAX_REQUEST_BODY_BYTES};
        proxy_request_buffering on;
        proxy_pass http://lyrashop_backend;
    }

    location @logout_rate_limited {
        internal;
        default_type application/problem+json;
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Expose-Headers "Retry-After, X-XSRF-TOKEN" always;
        add_header Vary "Origin" always;
        add_header Retry-After "${LOGOUT_RETRY_AFTER_SECONDS}" always;
        add_header Cache-Control "no-store" always;
        return 429 '{"timestamp":"$time_iso8601","status":429,"code":"LOGOUT_RATE_LIMITED","message":"Too many logout attempts","path":"/api/v1/auth/logout","fieldErrors":{}}';
    }

    location @logout_payload_too_large {
        internal;
        default_type application/problem+json;
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Vary "Origin" always;
        add_header Cache-Control "no-store" always;
        return 413 '{"timestamp":"$time_iso8601","status":413,"code":"PAYLOAD_TOO_LARGE","message":"Request body exceeds the allowed size","path":"/api/v1/auth/logout","fieldErrors":{}}';
    }

    location / {
        proxy_pass http://lyrashop_backend;
    }
}
