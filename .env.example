DB_URL=jdbc:mysql://localhost:3306/lyrashop_db?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=lyrashop
DB_PASSWORD=replace-with-a-local-password
MYSQL_USER=lyrashop
MYSQL_PASSWORD_SECRET_FILE=./deploy/secrets/mysql_password.txt
MYSQL_ROOT_PASSWORD_SECRET_FILE=./deploy/secrets/mysql_root_password.txt
JWT_SECRET_BASE64=replace-with-base64-encoded-32-byte-secret
JWT_SECRET_BASE64_SECRET_FILE=./deploy/secrets/jwt_secret_base64.txt
JWT_ISSUER=https://api.lyrashop.local
JWT_AUDIENCE=lyrashop-api
JWT_ACCESS_TOKEN_TTL=15m
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_MAX_REQUEST_BODY_BYTES=8192
AUTH_MAX_CONCURRENT_PASSWORD_HASHES=2
AUTH_RETRY_AFTER_SECONDS=1
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
EDGE_BIND_ADDRESS=127.0.0.1
EDGE_PORT=8080
API_SERVER_NAME=api.lyrashop.local
BACKEND_HOST=backend
BACKEND_PORT=8080
BACKEND_DNS_RESOLVER=127.0.0.11
REGISTRATION_CORS_ALLOWED_ORIGIN=http://localhost:5173
REGISTRATION_PER_IP_RATE=5r/m
REGISTRATION_PER_IP_BURST=2
REGISTRATION_GLOBAL_RATE=30r/m
REGISTRATION_GLOBAL_BURST=10
REGISTRATION_RETRY_AFTER_SECONDS=60
LOGIN_MAX_REQUEST_BODY_BYTES=4096
LOGIN_PER_IP_RATE=10r/m
LOGIN_PER_IP_BURST=5
LOGIN_GLOBAL_RATE=120r/m
LOGIN_GLOBAL_BURST=30
LOGIN_RETRY_AFTER_SECONDS=60
