VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay/return
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay/ipn
AUTH_MAX_CONCURRENT_PASSWORD_HASHES=2
AUTH_RETRY_AFTER_SECONDS=1
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/auth
PASSWORD_RESET_FROM=no-reply@lyrashop.local
PASSWORD_RESET_TOKEN_TTL=30m
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
EDGE_BIND_ADDRESS=127.0.0.1
EDGE_PORT=8080
API_SERVER_NAME=api.lyrashop.local
BACKEND_HOST=backend
BACKEND_PORT=8080
BACKEND_DNS_RESOLVER=127.0.0.11
REGISTRATION_CORS_ALLOWED_ORIGIN=http://localhost:5173
REGISTRATION_PER_IP_RATE=5r/m
REGISTRATION_PER_IP_BURST=2
REGISTRATION_GLOBAL_RATE=30r/m
REGISTRATION_GLOBAL_BURST=10
REGISTRATION_RETRY_AFTER_SECONDS=60
LOGIN_MAX_REQUEST_BODY_BYTES=4096
LOGIN_PER_IP_RATE=10r/m
LOGIN_PER_IP_BURST=5
LOGIN_GLOBAL_RATE=120r/m
LOGIN_GLOBAL_BURST=30
LOGIN_RETRY_AFTER_SECONDS=60
REFRESH_MAX_REQUEST_BODY_BYTES=1024
REFRESH_PER_IP_RATE=30r/m
REFRESH_PER_IP_BURST=10
REFRESH_GLOBAL_RATE=300r/m
REFRESH_GLOBAL_BURST=100
REFRESH_RETRY_AFTER_SECONDS=60
LOGOUT_MAX_REQUEST_BODY_BYTES=1024
LOGOUT_PER_IP_RATE=30r/m
LOGOUT_PER_IP_BURST=10
LOGOUT_GLOBAL_RATE=300r/m
LOGOUT_GLOBAL_BURST=100
